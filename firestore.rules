rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Enquiries / Mortal Audience Scrolls
    match /enquiries/{doc} {
      allow read, write: if true;
    }

    // Notice Board Dispatches
    match /notices/{doc} {
      allow read, write: if true;
    }

    // Visitor Domain Intelligence Analytics
    match /analytics/{doc} {
      allow read, write: if true;
    }

    // Rate Limiting
    match /rateLimits/{doc} {
      allow read, write: if true;
    }

    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
